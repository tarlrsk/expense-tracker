# Copy to .env and fill in. .env is gitignored; never commit it.
# The Makefile loads .env with the shell, so values containing & or other
# shell characters must stay inside single quotes.

# API listen address.
API_ADDR=127.0.0.1:8080
# Deadline on every request (Go duration, more than 0 and at most 60s; ADR-0043).
REQUEST_TIMEOUT=50s
# debug, info, warn or error.
LOG_LEVEL=info

# Neon development database (ADR-0026). Both are secrets. Use the DIRECT host,
# not the -pooler one (the pooler runs PgBouncer in transaction mode).
# The owner role (Neon's neondb_owner); read only by make migrate*, never by the API.
MIGRATION_DATABASE_URL='postgres://OWNER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require'
# The API's role app_login; after the first make migrate, run make db-login-password and paste the line it prints.
DATABASE_URL='postgres://app_login:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require'
# Statement timeout of every database transaction (less than REQUEST_TIMEOUT; ADR-0043).
DB_STATEMENT_TIMEOUT=20s
# Size of the API's database connection pool.
DB_MAX_OPEN_CONNS=10

# Test database: Postgres in docker-compose.yml (service postgres-test).
# Tests read only this one and never connect to Neon.
TEST_DATABASE_URL='postgres://postgres:postgres@127.0.0.1:5433/expense_test?sslmode=disable'
