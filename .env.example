# Copy to .env and fill in. .env is gitignored; never commit it.
# The Makefile loads .env with the shell, so values containing & or other
# shell characters must stay inside single quotes.

# API listen address.
API_ADDR=127.0.0.1:8080
# Deadline on every request (Go duration, more than 0 and at most 60s; ADR-0043).
REQUEST_TIMEOUT=50s
# debug, info, warn or error.
LOG_LEVEL=info

# Neon development database (ADR-0026). Both are secrets. Use the DIRECT host,
# not the -pooler one (the pooler runs PgBouncer in transaction mode).
# The owner role (Neon's neondb_owner); read only by make migrate*, never by the API.
MIGRATION_DATABASE_URL='postgres://OWNER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require'
# The API's role app_login; after the first make migrate, run make db-login-password and paste the line it prints.
DATABASE_URL='postgres://app_login:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require'
# Statement timeout of every database transaction (less than REQUEST_TIMEOUT; ADR-0043).
DB_STATEMENT_TIMEOUT=20s
# Size of the API's database connection pool.
DB_MAX_OPEN_CONNS=10

# Outgoing email over SMTP (ADR-0028). The defaults fit Mailpit from docker-compose.yml
# (web UI on http://127.0.0.1:8025), so these can stay commented out locally.
# SMTP_TLS: none (local only), starttls (STARTTLS is required) or tls (implicit TLS, usually port 465).
# SMTP_USERNAME and SMTP_PASSWORD go together and are refused with SMTP_TLS=none.
#SMTP_HOST=127.0.0.1
#SMTP_PORT=1025
#SMTP_USERNAME=
# A secret.
#SMTP_PASSWORD=
#SMTP_FROM='Satang <noreply@localhost>'
#SMTP_TLS=none

# The web app's address, used in emailed set-password links (ADR-0068): an absolute http or
# https URL without query or fragment. The default is the web dev server; a deployment must set
# its public address.
#WEB_BASE_URL=http://127.0.0.1:5173

# The one app-wide time zone (ADR-0042): an IANA name. It defines "today", so the latest date a
# transaction may have (one year after today).
#APP_TIME_ZONE=Asia/Bangkok

# The AI for smart entry (Anthropic, ADR-0009), called only from the API. Without a key the API
# still starts, and quick entry says the AI is not configured. Never put the key in a VITE_* variable.
# A secret.
#ANTHROPIC_API_KEY=
# The model id.
#ANTHROPIC_MODEL=claude-haiku-4-5
# Time limit of one AI call, retries included (Go duration, more than 0 and less than REQUEST_TIMEOUT).
#AI_TIMEOUT=20s
# How many quick-entry requests of one user may call the AI per day in APP_TIME_ZONE (a whole
# number, 0 or more; 0 means the AI is never called). Requests read without the AI do not count.
#AI_DAILY_PARSE_LIMIT=100

# Test database: Postgres in docker-compose.yml (service postgres-test).
# Tests read only this one and never connect to Neon.
TEST_DATABASE_URL='postgres://postgres:postgres@127.0.0.1:5433/expense_test?sslmode=disable'
